{
  "name": "tsdown",
  "type": "module",
  "version": "0.23.0",
  "description": "The Elegant Bundler for Libraries",
  "author": "Kevin Deng <sxzz@sxzz.moe>",
  "license": "MIT",
  "funding": "https://github.com/sponsors/sxzz",
  "homepage": "http://tsdown.dev/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rolldown/tsdown.git"
  },
  "bugs": {
    "url": "https://github.com/rolldown/tsdown/issues"
  },
  "exports": {
    ".": "./dist/index.mjs",
    "./config": "./dist/config.mjs",
    "./internal": "./dist/internal.mjs",
    "./plugins": "./dist/plugins.mjs",
    "./run": "./dist/run.mjs",
    "./package.json": "./package.json",
    "./client": "./client.d.ts"
  },
  "bin": {
    "tsdown": "./dist/run.mjs"
  },
  "files": [
    "client.d.ts",
    "dist",
    "esm-shims.js"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.3.1",
      "onFail": "download"
    }
  },
  "peerDependencies": {
    "@arethetypeswrong/core": "^0.18.1",
    "@tsdown/css": "0.23.0",
    "@tsdown/exe": "0.23.0",
    "@vitejs/devtools": "*",
    "publint": "^0.3.8",
    "tsx": "*",
    "typescript": "^5.0.0 || ^6.0.0 || ^7.0.0",
    "unplugin-unused": ">=0.5.0",
    "unrun": "*"
  },
  "peerDependenciesMeta": {
    "@arethetypeswrong/core": {
      "optional": true
    },
    "@tsdown/css": {
      "optional": true
    },
    "@tsdown/exe": {
      "optional": true
    },
    "@vitejs/devtools": {
      "optional": true
    },
    "publint": {
      "optional": true
    },
    "tsx": {
      "optional": true
    },
    "typescript": {
      "optional": true
    },
    "unplugin-unused": {
      "optional": true
    },
    "unrun": {
      "optional": true
    }
  },
  "dependencies": {
    "cac": "^7.0.0",
    "defu": "^6.1.7",
    "empathic": "^2.0.1",
    "hookable": "^6.1.1",
    "import-without-cache": "^0.4.0",
    "obug": "^2.1.4",
    "picomatch": "^4.0.7",
    "rolldown": "~1.2.7",
    "rolldown-plugin-dts": "^0.28.5",
    "tinyexec": "^1.3.1",
    "tinyglobby": "^0.2.17",
    "tree-kill": "^1.2.2",
    "unconfig-core": "^7.5.0",
    "verkit": "^0.4.0"
  },
  "inlinedDependencies": {
    "package-manager-detector": "1.8.0",
    "pkg-types": "2.3.2"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@sxzz/eslint-config": "^8.6.0",
    "@sxzz/prettier-config": "^2.3.2",
    "@sxzz/test-utils": "^0.5.18",
    "@tsdown/css": "0.23.0",
    "@tsdown/exe": "0.23.0",
    "@types/node": "^26.4.1",
    "@types/picomatch": "^4.0.3",
    "@typescript/native-preview": "npm:typescript@7.0.2",
    "@unocss/eslint-plugin": "^66.9.2",
    "@vitejs/devtools": "^0.7.1",
    "@vitest/coverage-v8": "^5.0.0",
    "@vitest/ui": "^5.0.0",
    "@vueuse/core": "^14.4.0",
    "actionspack": "^0.1.5",
    "baseline-browser-mapping": "^2.11.20",
    "bumpp": "^12.3.0",
    "dedent": "^1.7.2",
    "eslint": "^10.9.1",
    "memfs": "^4.69.1",
    "package-manager-detector": "^1.8.0",
    "pkg-types": "^2.3.2",
    "postcss": "^8.5.28",
    "postcss-import": "^17.0.0",
    "postcss-modules": "^9.0.1",
    "prettier": "^3.9.6",
    "publint": "^0.3.24",
    "rolldown-plugin-require-cjs": "^0.4.1",
    "sass": "^1.103.1",
    "tsnapi": "^1.4.2",
    "tsx": "^4.23.13",
    "typescript": "~6.0.3",
    "unocss": "^66.9.2",
    "unplugin-ast": "^0.19.0",
    "unplugin-raw": "^0.8.0",
    "unplugin-unused": "^0.6.0",
    "unplugin-vue": "^7.2.0",
    "unrun": "^0.3.1",
    "vite": "^8.2.2",
    "vitest": "^5.0.0",
    "vue": "^3.5.42"
  },
  "prettier": "@sxzz/prettier-config",
  "scripts": {
    "lint": "eslint --cache --max-warnings 0 .",
    "lint:fix": "pnpm run lint --fix",
    "build": "node -C dev ./src/run.ts",
    "dev": "pnpm run build",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "format": "prettier --cache --write .",
    "release": "node ./scripts/release.ts",
    "docs:dev": "pnpm -C docs run dev",
    "docs:build": "pnpm -C docs run build",
    "docs:preview": "pnpm -C docs run preview",
    "docs:generate": "pnpm -C docs run generate"
  }
}